FROM node:26-bookworm-slim

ARG CODEX_VERSION=0.156.1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates git make python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/memory-spark-venv \
    && /opt/memory-spark-venv/bin/pip install --no-cache-dir --upgrade pip \
    && npm install --global --no-audit --no-fund npm@latest @openai/codex@${CODEX_VERSION}

COPY pyproject.toml README.md ./
COPY apps ./apps

RUN /opt/memory-spark-venv/bin/pip install --no-cache-dir '.[test]'

RUN rm -f /usr/local/bin/python /usr/local/bin/python3 /usr/local/bin/pip /usr/local/bin/pytest /usr/local/bin/uvicorn \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/memory-spark-venv/bin/python "$@"' > /usr/local/bin/python \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/memory-spark-venv/bin/python "$@"' > /usr/local/bin/python3 \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/memory-spark-venv/bin/pip "$@"' > /usr/local/bin/pip \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/memory-spark-venv/bin/pytest "$@"' > /usr/local/bin/pytest \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/memory-spark-venv/bin/uvicorn "$@"' > /usr/local/bin/uvicorn \
    && chmod +x /usr/local/bin/python /usr/local/bin/python3 /usr/local/bin/pip /usr/local/bin/pytest /usr/local/bin/uvicorn

COPY harness/healthcheck.mjs /opt/memory-spark-harness/healthcheck.mjs
COPY harness/entrypoint.sh /usr/local/bin/memory-spark-codex-entrypoint
RUN chmod +x /usr/local/bin/memory-spark-codex-entrypoint

ENV CODEX_HOME=/codex-home
ENV PATH=/opt/memory-spark-venv/bin:$PATH

EXPOSE 8765

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD ["node", "/opt/memory-spark-harness/healthcheck.mjs"]

ENTRYPOINT ["/usr/local/bin/memory-spark-codex-entrypoint", "codex"]
CMD ["exec-server", "--listen", "ws://0.0.0.0:8765", "--concurrent-requests", "4"]
