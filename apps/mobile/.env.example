# Public HTTPS origin for the SAME deployed backend as web. Never paste service-role keys.
EXPO_PUBLIC_MEMOIR_API_URL=https://your-api.example/api/v1/memoir
# Development-only deterministic UI fixture. Contains synthetic memories. No network.
EXPO_PUBLIC_MEMOIR_FIXTURE=0

# Optional build-pinned PUBLIC identity configuration enables cached-session
# startup without fetching /agent/config. These must match the same backend.
# Never use a Supabase service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
