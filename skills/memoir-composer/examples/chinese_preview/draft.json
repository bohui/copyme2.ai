          "uncertainty": []
        },
        {
          "id": "b_room",
          "type": "paragraph",
          "text": "我和哥哥住在一间小卧室里。",
          "asset_id": null,
          "asset_version": null,
          "caption": "",
          "alt": "",
          "credit": "",
          "source_refs": [
