{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoir-story-game:request:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "memoir-story-game-request/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "phase": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "comfort",
            "explore",
            "shape"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "phase",
        "revision"
      ],
      "additionalProperties": false
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "correction_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "source_manifest_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manuscript": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "formal_memoir",
            "sample_chapter",
            "sample_storyline"
          ]
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "digest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60000
              }
            },
            "required": [
              "id",
              "revision",
              "digest",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "revision",
        "digest",
        "kind",
        "chapters"
      ],
      "additionalProperties": false
    },
    "completion": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "composition_run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "manuscript_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "manuscript_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "manuscript_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_manifest_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "chapter_coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "digest": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "revision",
                  "digest"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 128
            },
            "validation_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "validation_passed": {
              "type": "boolean"
            },
            "pending_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "blocking_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "receipt_id",
            "composition_run_id",
            "manuscript_id",
            "manuscript_revision",
            "manuscript_digest",
            "source_manifest_digest",
            "chapter_coverage",
            "validation_digest",
            "validation_passed",
            "pending_count",
            "blocking_count"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "consent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "purpose": {
              "const": "game_adaptation"
            },
            "audience": {
              "const": "private"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "revoked"
              ]
            },
            "manuscript_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "manuscript_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "manuscript_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "policy_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "receipt_id",
            "revision",
            "purpose",
            "audience",
            "status",
            "manuscript_id",
            "manuscript_revision",
            "manuscript_digest",
            "policy_epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "chapter_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60000
          },
          "role": {
            "type": "string",
            "enum": [
              "narrator",
              "explicit_confirmation",
              "assistant",
              "contributor"
            ]
          },
          "adaptation_allowed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked",
              "superseded"
            ]
          }
        },
        "required": [
          "id",
          "version",
          "chapter_id",
          "text",
          "role",
          "adaptation_allowed",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 512
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "alias_line_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "age_category": {
            "type": "string",
            "enum": [
              "adult",
              "minor",
              "unknown"
            ]
          },
          "adaptation_allowed": {
            "type": "boolean"
          },
          "specific_permission": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "receipt_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "purpose": {
                    "const": "game_adaptation"
                  },
                  "policy_epoch": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "subject_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                },
                "required": [
                  "receipt_id",
                  "purpose",
                  "policy_epoch",
                  "subject_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "alias_line_id",
          "age_category",
          "adaptation_allowed",
          "specific_permission"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 16
    },
    "approved_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^[^<>\\x00-\\x1f\\x7f]+$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "quote",
              "reviewed_paraphrase"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "evidence_id",
                "version",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          },
          "manuscript": {
            "type": "object",
            "properties": {
              "chapter_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            },
            "required": [
              "chapter_id",
              "revision",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "person_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "sensitive": {
            "type": "boolean"
          },
          "specific_permission": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "receipt_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "purpose": {
                    "const": "game_adaptation"
                  },
                  "policy_epoch": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "subject_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                },
                "required": [
                  "receipt_id",
                  "purpose",
                  "policy_epoch",
                  "subject_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "review_receipt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "npc_person_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "text",
          "mode",
          "evidence",
          "manuscript",
          "person_ids",
          "sensitive",
          "specific_permission",
          "review_receipt_id",
          "npc_person_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "generic-author",
              "generic-adult",
              "generic-garden",
              "generic-workroom"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^assets/memoir-story-game/[a-z0-9-]+\\.(png|webp)$"
          },
          "digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "enum": [
              "project-original",
              "CC0-1.0",
              "MIT"
            ]
          },
          "generic": {
            "const": true
          }
        },
        "required": [
          "key",
          "path",
          "digest",
          "license",
          "generic"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4
    },
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "fence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "expected_artifact_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "fence",
        "expected_artifact_revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "actor_id",
    "phase",
    "policy_epoch",
    "correction_epoch",
    "revocation_epoch",
    "source_manifest_digest",
    "manuscript",
    "completion",
    "consent",
    "evidence",
    "people",
    "approved_lines",
    "assets",
    "job"
  ],
  "additionalProperties": false
}
