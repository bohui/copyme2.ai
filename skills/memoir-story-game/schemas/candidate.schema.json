{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoir-story-game:candidate:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "memoir-story-game-candidate/1"
    },
    "request_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "game": {
      "$ref": "urn:memoir-story-game:game:1"
    },
    "grounding": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "approved_line_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "text_id",
          "approved_line_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "npc_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "person_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "npc_id",
          "person_id"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 16
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "reviewer_actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "candidate_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "approved": {
              "const": true
            }
          },
          "required": [
            "receipt_id",
            "reviewer_actor_id",
            "candidate_digest",
            "approved"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_digest",
    "game",
    "grounding",
    "identities",
    "review"
  ],
  "additionalProperties": false
}
