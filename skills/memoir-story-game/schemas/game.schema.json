{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoir-story-game:game:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "memoir-story-game-play/1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "renderer": {
      "const": "fixed-side-scroll-v1"
    },
    "audience": {
      "const": "private"
    },
    "title_text_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^[^<>\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 385
    },
    "protagonist": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "alias_text_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "asset_key": {
          "const": "generic-author"
        }
      },
      "required": [
        "id",
        "alias_text_id",
        "asset_key"
      ],
      "additionalProperties": false
    },
    "start_scene_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "title_text_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "asset_key": {
            "type": "string",
            "enum": [
              "generic-author",
              "generic-adult",
              "generic-garden",
              "generic-workroom"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 640,
            "maximum": 4096
          },
          "spawn_x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "left": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "scene_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "spawn_x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  }
                },
                "required": [
                  "scene_id",
                  "spawn_x"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "right": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "scene_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "spawn_x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  }
                },
                "required": [
                  "scene_id",
                  "spawn_x"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title_text_id",
          "asset_key",
          "width",
          "spawn_x",
          "left",
          "right"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "alias_text_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "asset_key": {
            "const": "generic-adult"
          },
          "dialogue_text_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "maxItems": 8
          }
        },
        "required": [
          "id",
          "scene_id",
          "x",
          "alias_text_id",
          "asset_key",
          "dialogue_text_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "controls": {
      "type": "object",
      "properties": {
        "keyboard": {
          "const": true
        },
        "touch": {
          "const": true
        },
        "text_equivalent": {
          "const": true
        },
        "reduced_motion": {
          "const": true
        }
      },
      "required": [
        "keyboard",
        "touch",
        "text_equivalent",
        "reduced_motion"
      ],
      "additionalProperties": false
    },
    "webpage": {
      "type": "string",
      "minLength": 100,
      "maxLength": 150000
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "renderer",
    "audience",
    "title_text_id",
    "texts",
    "protagonist",
    "start_scene_id",
    "scenes",
    "npcs",
    "controls"
  ],
  "additionalProperties": false
}
