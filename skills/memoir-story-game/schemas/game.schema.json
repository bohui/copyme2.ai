{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoir-story-game:game:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "memoir-story-game-play/1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "renderer": {
      "enum": [
        "fixed-side-scroll-v1",
        "memoir-linear-v2"
      ]
    },
    "audience": {
      "const": "private"
    },
    "title_text_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^[^<>\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 385
    },
    "protagonist": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "alias_text_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "asset_key": {
          "const": "generic-author"
        }
      },
      "required": [
        "id",
        "alias_text_id",
        "asset_key"
      ],
      "additionalProperties": false
    },
    "start_scene_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "title_text_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "asset_key": {
            "type": "string",
            "enum": [
              "generic-author",
              "generic-adult",
              "generic-garden",
              "generic-workroom"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 640,
            "maximum": 4096
          },
          "spawn_x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "left": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "scene_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "spawn_x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  }
                },
                "required": [
                  "scene_id",
                  "spawn_x"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "right": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "scene_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "spawn_x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  }
                },
                "required": [
                  "scene_id",
                  "spawn_x"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title_text_id",
          "asset_key",
          "width",
          "spawn_x",
          "left",
          "right"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "alias_text_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "asset_key": {
            "const": "generic-adult"
          },
          "dialogue_text_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "maxItems": 8
          }
        },
        "required": [
          "id",
          "scene_id",
          "x",
          "alias_text_id",
          "asset_key",
          "dialogue_text_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "controls": {
      "type": "object",
      "properties": {
        "keyboard": {
          "const": true
        },
        "touch": {
          "const": true
        },
        "text_equivalent": {
          "const": true
        },
        "reduced_motion": {
          "const": true
        }
      },
      "required": [
        "keyboard",
        "touch",
        "text_equivalent",
        "reduced_motion"
      ],
      "additionalProperties": false
    },
    "webpage": {
      "type": "string",
      "minLength": 100,
      "maxLength": 150000
    },
    "novel_game": {
      "type": "object",
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "fictional": {
              "type": "boolean"
            },
            "chapters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 400
                  }
                },
                "required": [
                  "id",
                  "title",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "fictional",
            "chapters"
          ],
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "blend": {
              "type": "integer",
              "minimum": 80,
              "maximum": 240
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "scene": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 640
                  },
                  "avatar": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "age_label": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "profession": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "id",
                  "scene",
                  "title",
                  "start",
                  "end",
                  "avatar",
                  "age_label",
                  "profession"
                ],
                "additionalProperties": false
              }
            },
            "stops": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "chapter": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "segment": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "x": {
                    "type": "integer",
                    "minimum": 100
                  },
                  "age_label": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "chapter",
                  "segment",
                  "x",
                  "age_label"
                ],
                "additionalProperties": false
              }
            },
            "order_note": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "version",
            "blend",
            "segments",
            "stops",
            "order_note"
          ],
          "additionalProperties": false
        },
        "css": {
          "type": "string",
          "maxLength": 24000
        },
        "scene_bindings": {
          "type": "object",
          "minProperties": 0,
          "maxProperties": 128,
          "additionalProperties": {
            "enum": [
              "home",
              "school",
              "workshop",
              "town",
              "interior",
              "garden"
            ]
          }
        },
        "illustrations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "properties": {
              "cache_key": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}/[a-f0-9]{64}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 256,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 256,
                "maximum": 3840
              },
              "scenes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,47}$"
                }
              }
            },
            "required": [
              "cache_key",
              "sha256",
              "width",
              "height",
              "scenes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "source",
        "plan",
        "css",
        "scene_bindings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {
                "const": 2
              }
            }
          },
          "then": {
            "required": [
              "illustrations"
            ]
          },
          "else": {
            "not": {
              "required": [
                "illustrations"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "renderer",
    "audience",
    "title_text_id",
    "texts",
    "protagonist",
    "start_scene_id",
    "scenes",
    "npcs",
    "controls"
  ],
  "additionalProperties": false
}
