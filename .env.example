MEMORY_SPARK_MODE=demo
MEMORY_SPARK_ENTITLEMENT_MODEL=chapter
# Successful conversation replies allowed before selecting a paid memoir package.
MEMORY_SPARK_FREE_RECALL_ROUNDS=20
MEMORY_SPARK_PRIVATE_DRAFT_CADENCE=5
MEMORY_SPARK_PRIVATE_DRAFTS_ENABLED=true
MEMORY_SPARK_REGION=au
MEMORY_SPARK_API_PORT=8010
MEMORY_SPARK_WEB_PORT=3010
MEMORY_SPARK_CODEX_VERSION=0.156.1
# Enable thinking steps on localhost/loopback browser URLs.
MEMORY_SPARK_SHOW_THINKING_STEPS=0
# Enable live draft previews independently on loopback browser URLs; leave off in production.
MEMORY_SPARK_SHOW_DRAFT_UPDATES=0
# Set a long random value in non-local environments. This secret is only used
# on the private API-to-Codex-worker network.
MEMORY_SPARK_CODEX_WORKER_SECRET=replace-with-a-random-worker-secret

SUPABASE_URL=https://vpzhimeqmuzyzfozcjnq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Account owning retained projects from make memoir-live-fifty-test.
# make memoir-live-fifty-login creates/confirms this test account without email.
MEMOIR_EVAL_USER_EMAIL=test@test.com
# Used by `make migrate` and the destructive `make db-truncate`; keep this connection string server-side.
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=memory-spark
LOCAL_OBJECT_STORE_PATH=var/memory-spark/objects
SUPABASE_JWKS_URL=https://vpzhimeqmuzyzfozcjnq.supabase.co/auth/v1/.well-known/jwks.json
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use Dashboard-created Price IDs. If blank, the API creates one-time
# price_data for each Checkout Session using the server-side amounts.
STRIPE_PRICE_ELECTRONIC=
STRIPE_PRICE_PRINTED=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_ADDITIONAL_BOOK=
# Use https://copyme2.ai when hosting through the local Cloudflare Tunnel.
MEMORY_SPARK_PUBLIC_URL=http://localhost:3010
MEMORY_SPARK_PRINT_COUNTRIES=AU
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Use a local Supabase Postgres URL or a hosted Supabase connection string.
# The provider Compose project must be running on this external network.
# For a different Mocker network, override MEMORY_SPARK_LLM_BASE_URL with its gateway.
MEMORY_SPARK_LLM_NETWORK=llm-provider-llm-network
MEMORY_SPARK_LLM_BASE_URL=http://192.168.65.1:4000/v1
MEMORY_SPARK_LLM_MODEL=gpt-5.6-luna-pooled
MEMORY_SPARK_LLM_REASONING_EFFORT=max
# Collector-only opt-in; leave blank/legacy until matched quality and latency acceptance.
# Verify the candidate route's underlying model and effective reasoning effort.
# Collector experiments: gpt-5.6-luna-memoir-low + low, or gpt-5.6-luna-memoir-high + high.
# reply-v2 + low resolves the known pooled route to gpt-5.6-luna-memoir-low.
# The gateway must authorize that dedicated low-policy route for API and worker.
MEMORY_SPARK_COLLECTOR_MODEL=
MEMORY_SPARK_COLLECTOR_REASONING_EFFORT=
MEMORY_SPARK_COLLECTOR_PROMPT_VERSION=compact-v1
# reply-v2 opts into the small foreground contract and saved Lane B continuity
# handoff. It requires enabled two lanes, matching API/worker code and published
# prompts; leave disabled until matched live latency and quality acceptance.
# Opt in only after current-source latency and bilingual quality acceptance.
MEMORY_SPARK_EARLY_POLICY_ACK=0
# Stream a revisable current reply while source privacy review runs in parallel.
# Requires reply-v2 and two lanes. Only the final reviewed reply is saved.
MEMORY_SPARK_PARALLEL_POLICY_REVIEW=0
# Structured background event extraction has its own latency budget.
MEMORY_SPARK_AUTHOR_TIMELINE_REASONING_EFFORT=low
MEMORY_SPARK_MEMOIR_COMPOSER_MODEL=memoir-luna-low
MEMORY_SPARK_MEMOIR_COMPOSER_REASONING_EFFORT=low
MEMORY_SPARK_LLM_API_KEY=
# Optional photo discovery through Responses web_search. Enable only with a
# gateway/model that returns completed native search receipts and sources.
MEMORY_SPARK_PHOTO_WEB_SEARCH=0
# Optional public historical context, researched after saved interview replies.
MEMORY_SPARK_HISTORICAL_NEWS=0
# Optional existing gateway alias when the main route forces high reasoning effort.
MEMORY_SPARK_HISTORICAL_NEWS_MODEL=
# Langfuse project used by the shared gateway and direct app-side calls.
# The gateway keeps its own project credentials; these are only needed by
# direct speech/evaluator calls and local trajectory publishing.
MEMORY_SPARK_LANGFUSE_BASE_URL=http://localhost:3001
MEMORY_SPARK_LANGFUSE_PUBLIC_KEY=
MEMORY_SPARK_LANGFUSE_SECRET_KEY=
MEMORY_SPARK_LANGFUSE_ENVIRONMENT=local
# Host-reachable URL for app containers; override for a hosted Langfuse URL.
MEMORY_SPARK_LANGFUSE_RUNTIME_BASE_URL=http://192.168.65.1:3001
# Direct server-side speech: Chinese uses Doubao Seed-ASR/TTS 2.0;
# English uses OpenAI Mini Transcribe and Gemini 3.8 Flash-Lite TTS.
# Configure each provider independently; a missing key disables only its operation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
# API Key from https://console.volcengine.com/speech/new/setting/apikeys
# Enable volc.seedasr.sauc.duration and seed-tts-2.0 for this key.
DOUBAO_API_KEY=
# These model overrides apply to English speech. Chinese remains on Seed 2.0.
MEMORY_SPARK_STT_MODEL=gpt-4o-mini-transcribe
MEMORY_SPARK_TTS_MODEL=gemini-3.8-flash-lite-tts
# Voice characters follow interview language, independently of interface language.
# Delivery instructions come from the versioned memoir/speech/... prompts.
MEMORY_SPARK_TTS_VOICE_EN_AU=Kore
MEMORY_SPARK_TTS_VOICE_ZH_CN=zh_female_vv_uranus_bigtts
# Realtime WebRTC SDP exchange (shares the server-only OpenAI credential).
MEMORY_SPARK_REALTIME_MODEL=gpt-realtime-2.1
MEMORY_SPARK_REALTIME_VOICE=marin

# Optional Flickr public photo search (server-side app key; not an OAuth secret).
FLICKR_API_KEY=
# Standard SerpAPI discovery uses Google Images + Google web search, plus Baidu
# for Chinese places: at most 3 searches / 12 original pages per period pass.
# Opt in to broader discovery: at most 7 searches / 36 pages, or 3 browser CSE
# queries / 12 pages. No extra credentials or database migration required.
MEMOIR_PHOTO_EXPANSION=0
# Server-side discovery key; photo permissions are checked on original records.
SERPAPI_KEY=
# Select both the geocoder and map tiles: google (default) or geoapify.
# Restart the API after changing this flag; reload the browser to pick it up.
MEMOIR_GEO_PROVIDER=google
# Server-only Google Geocoding key; separate referrer-restricted Map Tiles key.
GOOGLE_MAPS_GEOCODING_API_KEY=
GOOGLE_MAPS_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_MAPS_BROWSER_API_KEY=
# Server-only Geoapify key; separate origin-restricted browser map tiles key.
GEOAPIFY_API_KEY=
GEOAPIFY_GEOCODING_URL=https://api.geoapify.com/v1/geocode/search
GEOAPIFY_BROWSER_API_KEY=
# Optional Google Programmable Search Engine image search. The cx is public;
# the JSON API key is server-side and optional for existing Google API customers.
# CSE runs alongside SerpAPI when configured. Failed JSON API calls fall back to
# browsing the public engine. A cx does not grant JSON API access.
GOOGLE_CSE_ID=b2de41f6592f74c3e
GOOGLE_CSE_API_KEY=
# Optional full CSE page URL (with cx); used by the keyless browser fallback.
GOOGLE_CSE_URL=

# Canonical generation is the only conversation engine. Pause model work here;
# saved history remains available while paused. Transcription also requires the
# approved original-recording identity/consent gates below.
MEMOIR_LIFETIME_GENERATION_PAUSED=0
MEMOIR_PUBLICATION_DATABASE_URL=

# Also requires the separately approved database-owner rollout guard.
# Experimental conversation / derived memory lanes. Server-owned; OFF until review and matched live evidence.
MEMOIR_TWO_LANES=0

# Opt-in selector variant also requires two-lane-v1 or reply-v2 above
# and a separately approved private DB strategy rollout (disabled/shadow by default).
MEMOIR_INTERVIEW_STRATEGY=0

# Issue 73 original retention is OFF; database rollout and an approved identity/
# consent authority are also required. This flag alone never authorizes retention.
MEMOIR_ORIGINAL_RECORDINGS=0
