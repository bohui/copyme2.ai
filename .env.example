MEMORY_SPARK_MODE=demo
MEMORY_SPARK_ENTITLEMENT_MODEL=chapter
MEMORY_SPARK_REGION=au
MEMORY_SPARK_API_PORT=8010
MEMORY_SPARK_WEB_PORT=3010
MEMORY_SPARK_CODEX_VERSION=0.156.1
# Keep high-level agent activity hidden in production. Enable only for local debugging.
MEMORY_SPARK_SHOW_THINKING_STEPS=0
# Set a long random value in non-local environments. This secret is only used
# on the private API-to-Codex-worker network.
MEMORY_SPARK_CODEX_WORKER_SECRET=replace-with-a-random-worker-secret

SUPABASE_URL=https://vpzhimeqmuzyzfozcjnq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Used by `make migrate` and `make db-truncate`; keep this connection string server-side.
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=memory-spark
LOCAL_OBJECT_STORE_PATH=var/memory-spark/objects
SUPABASE_JWKS_URL=https://vpzhimeqmuzyzfozcjnq.supabase.co/auth/v1/.well-known/jwks.json
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use Dashboard-created Price IDs. If blank, the API creates one-time
# price_data for each Checkout Session using the server-side amounts.
STRIPE_PRICE_ELECTRONIC=
STRIPE_PRICE_PRINTED=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_ADDITIONAL_BOOK=
MEMORY_SPARK_PUBLIC_URL=http://localhost:3010
MEMORY_SPARK_PRINT_COUNTRIES=AU
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Use a local Supabase Postgres URL or a hosted Supabase connection string.
# The provider Compose project must be running on this external network.
# For a different Mocker network, override MEMORY_SPARK_LLM_BASE_URL with its gateway.
MEMORY_SPARK_LLM_NETWORK=llm-provider-llm-network
MEMORY_SPARK_LLM_BASE_URL=http://192.168.68.1:4000/v1
MEMORY_SPARK_LLM_MODEL=deepseek-v4-flash
MEMORY_SPARK_LLM_API_KEY=
# Optional local/CI trajectory publishing. The Langfuse project and callback
# remain hosted by llm_provider; these keys are used only by the evaluator.
MEMORY_SPARK_LANGFUSE_BASE_URL=http://localhost:3001
MEMORY_SPARK_LANGFUSE_PUBLIC_KEY=
MEMORY_SPARK_LANGFUSE_SECRET_KEY=
MEMORY_SPARK_LANGFUSE_ENVIRONMENT=local
# Optional server-side speech provider. Leave blank to keep typed input and
# browser read-aloud as the local fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_SPARK_STT_MODEL=gpt-4o-mini-transcribe
MEMORY_SPARK_TTS_MODEL=gpt-4o-mini-tts
# Realtime WebRTC SDP exchange (shares the server-only OpenAI credential).
MEMORY_SPARK_REALTIME_MODEL=gpt-realtime-2.1
MEMORY_SPARK_REALTIME_VOICE=marin

# Optional Flickr public photo search (server-side app key; not an OAuth secret).
FLICKR_API_KEY=
