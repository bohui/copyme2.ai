      "synthetic": {
        "reply": "I queued a deterministic preview task from the saved collection; it is not finished yet.[[MEMORY_SPARK_TASKS]][{\"kind\":\"BuildFreePreview\",\"memory_ids\":[\"memory-preview\"],\"title\":\"Saved preview\"}][[/MEMORY_SPARK_TASKS]]",
        "steps": [
