    {
      "id": "collection-review-before-selection",
      "input": {"text": "Please review my saved collection before I choose a book."},
      "project_id": "synthetic-collection-review",
      "memories": [{"id": "memory-review", "kind": "memoir", "content": "A saved review memory.", "source_paths": []}],
      "synthetic": {
        "reply": "Your saved collection is ready for review; no book has been selected yet.",
