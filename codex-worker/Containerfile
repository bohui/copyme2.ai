FROM node:26-bookworm-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    CODEX_HOME=/var/lib/memory-spark/codex-users \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates python3 python3-venv util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/memory-spark-venv \
    && /opt/memory-spark-venv/bin/pip install --no-cache-dir --upgrade pip \
    && mkdir -p /var/lib/memory-spark/codex-users \
    && chmod 711 /var/lib/memory-spark/codex-users

ENV PATH=/opt/memory-spark-venv/bin:$PATH

COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -c 'import tomllib; m=tomllib.load(open("pyproject.toml", "rb")); p=m["project"]; print("\n".join(m["build-system"]["requires"] + p["dependencies"] + p["optional-dependencies"]["lifetime-memory"] + [v for v in p["optional-dependencies"]["test"] if v.startswith("playwright")]))' > /tmp/memory-spark-requirements.txt \
    && pip install -r /tmp/memory-spark-requirements.txt \
    && rm /tmp/memory-spark-requirements.txt \
    && python -m playwright install --with-deps chromium

ARG CODEX_VERSION=0.156.1
RUN --mount=type=cache,target=/root/.npm \
    npm install --global --no-audit --no-fund npm@latest @openai/codex@${CODEX_VERSION}

COPY scripts/verify_codex_worker_isolation.py /usr/local/libexec/verify_codex_worker_isolation.py

EXPOSE 8766

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8766/health').read()"

CMD ["uvicorn", "apps.api.codex_worker_service:app", "--host", "0.0.0.0", "--port", "8766"]

# Local Compose mounts application files onto this stable dependency image.
FROM runtime AS app

COPY apps/__init__.py ./apps/__init__.py
COPY apps/api ./apps/api
RUN pip install --no-cache-dir --no-deps --no-build-isolation '.[lifetime-memory]'

COPY README.md ./
COPY skills ./skills
COPY experiments/novel-to-game ./experiments/novel-to-game
COPY deps ./deps
